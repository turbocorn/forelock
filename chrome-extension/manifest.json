{
  "manifest_version": 3,
  "name": "Forelock Music Bridge",
  "version": "0.4.0",
  "minimum_chrome_version": "120",
  "description": "Playback metadata and controls for Yandex Music and Zvuk in Forelock.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://music.yandex.ru/*",
    "https://music.yandex.com/*",
    "https://zvuk.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.yandex.ru/*",
        "https://music.yandex.com/*",
        "https://zvuk.com/*"
      ],
      "js": [
        "page-player.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://music.yandex.ru/*",
        "https://music.yandex.com/*",
        "https://zvuk.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_title": "Forelock Music Bridge",
    "default_popup": "popup.html"
  }
}
